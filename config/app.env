############################################################
# App + DB config example
############################################################

# API server bind address
SERVER_ADDR=0.0.0.0:8080

# Token config
TOKEN_TYPE=PasetoS
TOKEN_SYMMETRIC_KEY=12345678901234567890123456789012
ACCESS_TOKEN_DURATION=15m

# Postgres credentials 
POSTGRES_USER=root
POSTGRES_PASSWORD=secret
DB_NAME=simple_bank
DB_PORT=5432

# If using the docker-compose postgres service:
DB_SOURCE=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:$DB_PORT/$DB_NAME?sslmode=disable

# If using an external Postgres instead, comment the line above and set like:
# DB_SOURCE=postgresql://<user>:<password>@<host>:<port>/<db_name>?sslmode=disable